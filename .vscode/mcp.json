{
  "servers": {
    "influxdb-traffic": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@influxdata/influxdb3-mcp-server"],
      "env": {
        "INFLUX_DB_INSTANCE_URL": "http://localhost:8181/",
        "INFLUX_DB_TOKEN": "",
        "INFLUX_DB_PRODUCT_TYPE": "core",
        "INFLUX_DB_DATABASE": "traffic"
      }
    }
  }
}
